<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Minimal XML theme for a pure Jetpack Compose app.
        All actual theming (colors, typography, shapes) is handled by MoneoTheme in Compose.
        Parent uses the always-available Material theme (API 21+) with no action bar.
    -->
    <style name="Theme.Moneo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
